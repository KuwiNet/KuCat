#!/bin/sh

# 注册主题
uci batch <<-EOF
	set luci.themes.KuCat=/luci-static/kucat
	set luci.main.mediaurlbase=/luci-static/kucat
	commit luci
EOF

# 确保 kucat 配置存在，并自动开启壁纸背景（安装/升级后生效，无需手动设置）
if [ -f /etc/config/kucat ]; then
	if uci -q get kucat.@basic[0] >/dev/null 2>&1; then
		uci set kucat.@basic[0].bkuse=1
		uci -q get kucat.@basic[0].background >/dev/null 2>&1 || uci set kucat.@basic[0].background=0
	else
		uci add kucat basic
		uci set kucat.@basic[0].bkuse=1
		uci set kucat.@basic[0].background=0
	fi
else
	uci set kucat.basic=basic
	uci set kucat.basic.bkuse=1
	uci set kucat.basic.background=0
fi
uci commit kucat 2>/dev/null || true

chmod +x /usr/libexec/rpcd/luci.kucat*
rm -rf /tmp/luci-*
exit 0
